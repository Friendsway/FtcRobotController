<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspiresRobot" name="BioBuzzStarterBot">
    <!-- REV Control Hub (Primary Controller) -->
    <LynxModule name="Control Hub" port="173">
        <!-- Mecanum Drivetrain Motors -->
        <Motor name="left_front_drive" port="0" />
        <Motor name="right_front_drive" port="1" />
        <Motor name="left_back_drive" port="2" />
        <Motor name="right_back_drive" port="3" />

        <!-- Servo Ports -->
        <ContinuousRotationServo name="left_intake_servo" port="0" />
        <ContinuousRotationServo name="right_intake_servo" port="1" />
        <ContinuousRotationServo name="windmill" port="5" />

        <!-- Control Hub Internal IMU -->
        <LynxEmbeddedIMU name="imu" port="0" bus="0" />

        <!-- goBILDA Pinpoint Odometry Computer (I2C Bus 1) -->
        <GoBildaPinpointDriver name="pinpoint" port="1" bus="1" />
    </LynxModule>

    <!-- REV Expansion Hub (Connected via RS485 & XT30 Power Extension) -->
    <LynxModule name="Expansion Hub" port="2">
        <!-- Mechanism Motors -->
        <Motor name="intake" port="0" />
        <Motor name="launcher" port="1" />
    </LynxModule>
</Robot>
